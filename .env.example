APP_NAME="Central SaaS"
APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_KEY=change-me
COMPANY_DOCUMENT=
COMPANY_PERSONAL_DOCUMENTS=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=central_saas
DB_USERNAME=root
DB_PASSWORD=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

MAIL_FROM=no-reply@seudominio.com
MAIL_FROM_NAME="RQCode"
MAIL_TO_FINANCEIRO=financeiro@seudominio.com
ALERT_RECIPIENTS=administracao@seudominio.com
ALERT_DUE_DAYS=7
ALERT_NEW_ACCOUNTS=true
ALERT_ACCOUNTS_SINCE=2026-08-02
MAIL_TO_CONTACT=contato@seudominio.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Integração administrativa Fleetway (mesmo segredo dos dois lados)
FLEETWAY_INTEGRATION_URL=http://127.0.0.1:8000
FLEETWAY_INTEGRATION_SECRET=

# Asaas: credenciais independentes por ambiente; não inserir segredos no Git.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Opcional: bundle PEM confiável quando o PHP não possui certificados configurados.
ASAAS_CA_BUNDLE=
ASAAS_SANDBOX_API_KEY=
ASAAS_SANDBOX_WEBHOOK_TOKEN=
# Chave aleatória exclusiva (32+ caracteres) para proteger a impressão do CPF/CNPJ.
BILLING_DOCUMENT_KEY=
